# --- Local agent / runtime state ---
.clrun/
.claude/
.codex/

# --- Environment files & secrets ---
# All real env variants are ignored; only the explicit example templates
# listed in the negations below are allowed into the repository.
.env*
*.env
*.env.*
.dev.vars*
.relay.env*
auth.json
credentials.json
*.credentials.json
.npmrc
!.dev.vars.example
!.relay.env.example

