{
  "name": "friends-ai-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "client": "node bin/ai-proxy.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:codex": "npm run build && node tools/smoke-codex.mjs && node tools/smoke-codex.mjs --responses && node tools/smoke-codex.mjs --codex-worker",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "npx auth@1.7.5 generate --config ./tools/auth-schema.ts --output ./src/db/schema.ts --yes",
    "check": "npm run typecheck && npm test && npm run test:client && npm run build && npm run build:server",
    "build": "wrangler deploy --env \"\" --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply ai-proxy --local",
    "deploy": "wrangler deploy --config wrangler.production.local.jsonc --env production",
    "test:client": "node --test test/client-models.test.mjs",
    "test:client:package": "node tools/test-client-package.mjs",
    "test:docker": "node tools/test-docker.mjs",
    "build:server": "node tools/build-server.mjs",
    "start:server": "node dist-server/main.mjs",
    "db:server": "node dist-server/db-cli.mjs",
    "test:server": "vitest run --project node test/server-",
    "test:server:docker": "node tools/test-server-docker.mjs",
    "test:native:docker": "node tools/test-native-docker.mjs"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/node": "^22.20.4",
    "better-call": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "miniflare": "^5.20260918.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
