// Public template. Copy to wrangler.production.local.jsonc and configure your deployment.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-proxy",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ALLOWED_HACKCLUB_IDS": "",
    "REQUESTS_PER_MINUTE": "20",
    "PROVIDERS_JSON": "[{\"id\":\"codex\",\"protocol\":\"codex\",\"discoverModels\":true,\"models\":{}}]",
    "OWNER_HACKCLUB_ID": ""
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "env": {
    "production": {
      "name": "ai-proxy",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ai-proxy",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://proxy.example.com",
        "ALLOWED_HACKCLUB_IDS": "",
        "REQUESTS_PER_MINUTE": "20",
        "PROVIDERS_JSON": "[{\"id\":\"codex\",\"protocol\":\"codex\",\"discoverModels\":true,\"models\":{}}]",
        "OWNER_HACKCLUB_ID": ""
      },
      "routes": [
        {
          "pattern": "proxy.example.com",
          "custom_domain": true
        }
      ]
    }
  }
}
