# This image contains only the integration client, never Worker or account secrets.
FROM node:22.23.2-bookworm@sha256:dd5847a04b0deee391fa145f1f4c6d214196668b6bcc7988ebed67249f226844
RUN npm install --global @openai/codex@0.154.0 && npm cache clean --force
WORKDIR /opt/ai-proxy
COPY bin/ ./bin/
COPY tools/docker-live.mjs ./tools/docker-live.mjs
USER node
ENTRYPOINT ["node", "/opt/ai-proxy/tools/docker-live.mjs"]
